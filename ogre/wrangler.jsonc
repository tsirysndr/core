{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogre",
  "main": "src/index.tsx",
  "compatibility_date": "2026-03-07",
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "ogre.tangled.network",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.woff"],
      "fallthrough": true,
    },
  ],
}
